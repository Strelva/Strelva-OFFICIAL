# Strelva — Production Environment Template
# Use this as the Vercel Production checklist. Do not copy local/test keys here.

# ── Data backbone + Auth (Supabase) — THE LIVE PATH ───────
# Supabase is the source of truth in prod (auth + tenant + content + ops data).
# The *_SOURCE flags MUST be "postgres" — otherwise the app silently reads stale
# Sanity. `pnpm check:prod` enforces all of these.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; bypasses RLS — never expose to the browser
CONTENT_SOURCE=postgres
TENANTS_SOURCE=postgres
DATA_SOURCE=postgres

# ── Auth (Clerk — LEGACY, teardown pending) ───────────────
# Being removed; only proxy.ts + auth.ts still import @clerk. Prod auth runs on
# Supabase above. Keep these only until the Clerk teardown ships.
# Production launch requires live Clerk keys. `pnpm check:prod` rejects pk_test_ / sk_test_.
# Keep publishable key, secret key, and webhook secret from the same live Clerk instance.
# Mixed Clerk instances can make /sign-in loop before the UI loads.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
SUPER_ADMIN_EMAILS=

# ── AI Agent ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Content Storage (Sanity CMS) ──────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# ── Migration Source Flags (Postgres is the prod source of truth) ──
# All three MUST be "postgres" in production (flipped 2026-06-20); Sanity/Redis
# stay dual-written for reversible rollback but are not read while these are on.
CONTENT_SOURCE=postgres
TENANTS_SOURCE=postgres
DATA_SOURCE=postgres

# ── Redis/Cache (Upstash) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=

# ── Billing (Stripe) — optional ──────────────────────────
# Admin-side billing is off until STRIPE_SCAFFOLD_PRICE_ID is set. Production
# still requires live keys (sk_live_) when Stripe is wired at all; check:prod
# rejects sk_test_. When the price is set it must be a live recurring monthly
# USD price. The amount is undecided while client sites are free.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_SCAFFOLD_PRICE_ID=
STRIPE_WEBHOOK_SECRET=whsec_...
# Comma-separated tenant ids exempt from the subscription gate (treated as
# active). Inert while billing is off. IMPORTANT: set this in the SAME deploy
# that sets STRIPE_SCAFFOLD_PRICE_ID, listing all existing tenants (e.g.
# "gldf,rohlax"), so tenants without a subscriptionStatus don't get 402'd the
# moment billing flips on.
STRIPE_BILLING_GRANDFATHER_TENANTS=

# ── Newsletter / Reports (Resend) ────────────────────────
RESEND_API_KEY=re_...
RESEND_DOMAIN=updates.strelva.com

# ── Cron & Internal API Security ─────────────────────────
CRON_SECRET=
INTERNAL_API_SECRET=
OAUTH_STATE_SECRET=
# Shared bearer secret used to authenticate Strelva -> custom-repo
# /api/reb-custom-request calls. Set the canonical SCAFFOLD_* name on new
# environments. REB_CUSTOM_REQUEST_SECRET is kept as a legacy alias because
# deployed custom repos (Rohlax, GLDF) still expect that name; the agent
# route reads SCAFFOLD_* first and falls back to REB_*.
SCAFFOLD_CUSTOM_REQUEST_SECRET=
REB_CUSTOM_REQUEST_SECRET=

# ── Monitoring ────────────────────────────────────────────
# Use the server/project DSN for SENTRY_DSN and the browser/client DSN for NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Site / Domain Routing ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://strelva.com
# Required only when Google, Instagram, or Calendly OAuth connections are enabled.
NEXT_PUBLIC_APP_URL=https://strelva.com
CUSTOM_DOMAIN_MAP={"greatlakesdriedfruit.com":"gldf","rohlaxwellness.com":"rohlax"}
MARKETING_DOMAINS=strelva.com,www.strelva.com

# ── Optional Integrations ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=
SLACK_WEBHOOK_URL=
FOUNDER_CLERK_USER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
VEGARO_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=
GOOGLE_SEARCH_CONSOLE_KEY=
# Google PageSpeed Insights API key — enables the site audit's Core Web Vitals +
# mobile categories. Optional; without it those categories grade at weight 0.
GOOGLE_PAGESPEED_API_KEY=

# ── Launch Flags ─────────────────────────────────────────
AI_AUTO_PUBLISH=false
# Self-serve auto-provisioning is off — every site is hand-built.
SELF_SERVE_ENABLED=false
