# Scaffold Web — Production Environment Template
# Use this as the Vercel Production checklist. Do not copy local/test keys here.

# ── Auth (Clerk) ──────────────────────────────────────────
# Production launch requires live Clerk keys. `pnpm check:prod` rejects pk_test_ / sk_test_.
# Keep publishable key, secret key, and webhook secret from the same live Clerk instance.
# Mixed Clerk instances can make /sign-in loop before the UI loads.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
SUPER_ADMIN_EMAILS=

# ── AI Agent ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Content Storage (Sanity CMS) ──────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# ── Redis/Cache (Upstash) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=

# ── Billing (Stripe) — optional ──────────────────────────
# Admin-side billing is off until STRIPE_SCAFFOLD_PRICE_ID is set. Production
# still requires live keys (sk_live_) when Stripe is wired at all; check:prod
# rejects sk_test_. When the price is set it must be a live recurring monthly
# USD price. The amount is undecided while client sites are free.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_SCAFFOLD_PRICE_ID=
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Newsletter / Reports (Resend) ────────────────────────
RESEND_API_KEY=re_...
RESEND_DOMAIN=updates.scaffoldweb.com

# ── Cron & Internal API Security ─────────────────────────
CRON_SECRET=
INTERNAL_API_SECRET=
OAUTH_STATE_SECRET=
# Shared bearer secret used to authenticate Scaffold Web -> custom-repo
# /api/reb-custom-request calls. Set the canonical SCAFFOLD_* name on new
# environments. REB_CUSTOM_REQUEST_SECRET is kept as a legacy alias because
# deployed custom repos (Rohlax, GLDF) still expect that name; the agent
# route reads SCAFFOLD_* first and falls back to REB_*.
SCAFFOLD_CUSTOM_REQUEST_SECRET=
REB_CUSTOM_REQUEST_SECRET=

# ── Monitoring ────────────────────────────────────────────
# Use the server/project DSN for SENTRY_DSN and the browser/client DSN for NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Site / Domain Routing ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://scaffoldweb.com
# Required only when Google, Instagram, or Calendly OAuth connections are enabled.
NEXT_PUBLIC_APP_URL=https://scaffoldweb.com
CUSTOM_DOMAIN_MAP={"greatlakesdriedfruit.com":"gldf","rohlaxwellness.com":"rohlax"}
MARKETING_DOMAINS=scaffoldweb.com,www.scaffoldweb.com

# ── Optional Integrations ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=
SLACK_WEBHOOK_URL=
FOUNDER_CLERK_USER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
VEGARO_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=
GOOGLE_SEARCH_CONSOLE_KEY=

# ── Launch Flags ─────────────────────────────────────────
AI_AUTO_PUBLISH=false
# Self-serve auto-provisioning is off — every site is hand-built.
SELF_SERVE_ENABLED=false
