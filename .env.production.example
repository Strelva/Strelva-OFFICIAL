# Strelva — Production Environment Template
# Use this as the Vercel Production checklist. Do not copy local/test keys here.

# ── Data backbone + Auth (Supabase) — THE LIVE PATH ───────
# Supabase is the source of truth in prod (auth + tenant + content + ops data).
# The *_SOURCE flags MUST be "postgres". `pnpm check:prod` enforces them.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; bypasses RLS — never expose to the browser
CONTENT_SOURCE=postgres
TENANTS_SOURCE=postgres
DATA_SOURCE=postgres

# ── AI Agent ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Legacy Sanity image references (temporary) ───────────
# No content read/write uses Sanity. Retain only until legacy asset URLs are
# rewritten, then remove the resolver and these values.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Redis/Cache (Upstash) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=

# ── Billing (Stripe) ──────────────────────────────────────
# Plan selection is persisted on the tenant. STRIPE_SCAFFOLD_PRICE_ID remains
# the compatibility rollout gate and Growth fallback; plan prices are otherwise
# independent.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_PRESENCE=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_SCAFFOLD_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Comma-separated tenant ids exempt from the subscription gate (treated as
# active). Inert while billing is off. IMPORTANT: set this in the SAME deploy
# that sets STRIPE_SCAFFOLD_PRICE_ID, listing all existing tenants (e.g.
# "gldf,rohlax"), so tenants without a subscriptionStatus don't get 402'd the
# moment billing flips on.
STRIPE_BILLING_GRANDFATHER_TENANTS=

# ── Newsletter / Reports (Resend) ────────────────────────
RESEND_API_KEY=re_...
RESEND_DOMAIN=updates.strelva.com
# Four explicit audiences; every send routes through src/lib/email/send.ts.
# Client lifecycle mail stays paused until deliberately enabled.
EMAIL_SENDING_ENABLED=
OPERATOR_EMAILS_ENABLED=true
PROSPECT_EMAILS_ENABLED=true
CUSTOMER_EMAIL_ENABLED=false
# Comma-separated operator addresses that receive "new lead" notifications
# (e.g. "jacob@strelva.com,noah@strelva.com").
LEAD_NOTIFY_EMAILS=

# ── Cron & Internal API Security ─────────────────────────
CRON_SECRET=
INTERNAL_API_SECRET=
OAUTH_STATE_SECRET=
# Shared bearer secret used to authenticate Strelva -> custom-repo
# /api/reb-custom-request calls. Set the canonical SCAFFOLD_* name on new
# environments. REB_CUSTOM_REQUEST_SECRET is kept as a legacy alias because
# deployed custom repos (Rohlax, GLDF) still expect that name; the agent
# route reads SCAFFOLD_* first and falls back to REB_*.
SCAFFOLD_CUSTOM_REQUEST_SECRET=
REB_CUSTOM_REQUEST_SECRET=

# ── Monitoring ────────────────────────────────────────────
# Use the server/project DSN for SENTRY_DSN and the browser/client DSN for NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Site / Domain Routing ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://strelva.com
# Canonical control-plane origin for callbacks, webhooks, and live checks.
NEXT_PUBLIC_APP_URL=https://app.strelva.com
CUSTOM_DOMAIN_MAP={"greatlakesdriedfruit.com":"gldf","rohlaxwellness.com":"rohlax"}
# Only legacy marketing hosts routed to this project. strelva.com lives in the
# separate strelva-marketing deployment.
MARKETING_DOMAINS=scaffoldweb.com,www.scaffoldweb.com

# ── Optional Integrations ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=
SLACK_WEBHOOK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
VEGARO_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=
GOOGLE_SEARCH_CONSOLE_KEY=
# Google PageSpeed Insights API key — enables the site audit's Core Web Vitals +
# mobile categories. Optional; without it those categories grade at weight 0.
GOOGLE_PAGESPEED_API_KEY=

# ── Launch Flags ─────────────────────────────────────────
AI_AUTO_PUBLISH=false
# Self-serve auto-provisioning is off — every site is hand-built.
SELF_SERVE_ENABLED=false
