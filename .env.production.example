# Scaffold Web — Production Environment Template
# Use this as the Vercel Production checklist. Do not copy local/test keys here.

# ── Auth (Clerk) ──────────────────────────────────────────
# Production launch requires live Clerk keys. `pnpm check:prod` rejects pk_test_ / sk_test_.
# Keep publishable key, secret key, and webhook secret from the same live Clerk instance.
# Mixed Clerk instances can make /sign-in loop before the UI loads.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
SUPER_ADMIN_EMAILS=

# ── AI Agent ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Content Storage (Sanity CMS) ──────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# ── Redis/Cache (Upstash) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=

# ── Billing (Stripe) ─────────────────────────────────────
# Production launch requires live Stripe keys. `pnpm check:prod` rejects sk_test_.
# STRIPE_SCAFFOLD_PRICE_ID must be the live recurring monthly USD price for exactly $149/month.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_SCAFFOLD_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Newsletter / Reports (Resend) ────────────────────────
RESEND_API_KEY=re_...
RESEND_DOMAIN=

# ── Cron & Internal API Security ─────────────────────────
CRON_SECRET=
INTERNAL_API_SECRET=
OAUTH_STATE_SECRET=
# Shared with custom storefronts that expose /api/reb-custom-request.
REB_CUSTOM_REQUEST_SECRET=

# ── Monitoring ────────────────────────────────────────────
# Use the server/project DSN for SENTRY_DSN and the browser/client DSN for NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Site / Domain Routing ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://scaffoldweb.com
# Required only when Google, Instagram, or Calendly OAuth connections are enabled.
NEXT_PUBLIC_APP_URL=https://scaffoldweb.com
CUSTOM_DOMAIN_MAP={"greatlakesdriedfruit.com":"gldf","rohlaxwellness.com":"rohlax"}
MARKETING_DOMAINS=scaffoldweb.com,www.scaffoldweb.com,reb-studio.vercel.app,reb.studio,www.reb.studio

# ── Optional Integrations ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=
SLACK_WEBHOOK_URL=
FOUNDER_CLERK_USER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
VEGARO_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=
GOOGLE_SEARCH_CONSOLE_KEY=

# ── Launch Flags ─────────────────────────────────────────
AI_AUTO_PUBLISH=false
SMS_SUGGESTIONS_ENABLED=false
