{
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "benchmarks/**/*.ts",
    "custom-repo-starter/**/*.ts",
    "custom-repo-starter/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-playwright/types/**/*.ts",
    ".next-playwright/dev/types/**/*.ts",
    ".next-inquiries/types/**/*.ts",
    ".next-inquiries/dev/types/**/*.ts",
    ".next-local-review/types/**/*.ts",
    ".next-local-review/dev/types/**/*.ts",
    ".next-topology/types/**/*.ts",
    ".next-topology/dev/types/**/*.ts",
    ".next-components-restart/types/**/*.ts",
    ".next-components-restart/dev/types/**/*.ts",
    ".next-visible-review/types/**/*.ts",
    ".next-visible-review/dev/types/**/*.ts",
    ".next-navcheck/types/**/*.ts",
    ".next-navcheck/dev/types/**/*.ts",
    ".next-w6-inquiries/types/**/*.ts",
    ".next-w6-inquiries/dev/types/**/*.ts",
    ".next-w6-inquiry-journeys/types/**/*.ts",
    ".next-w6-inquiry-journeys/dev/types/**/*.ts",
    ".next-inquiry-running-proof/types/**/*.ts",
    ".next-inquiry-running-proof/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.template.tsx"
  ]
}
