# Scaffold Web — Required Environment Variables
# Copy to .env.local and fill in values

# ── Auth (Clerk) ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Super admin emails (comma-separated) — these users get admin access
SUPER_ADMIN_EMAILS=rhinehart514@gmail.com

# ── AI Agent ──────────────────────────────────────────────
# Google Gemini (primary LLM for chat agent)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Anthropic Claude (optional fallback)
# ANTHROPIC_API_KEY=

# ── Content Storage (Sanity CMS) ──────────────────────────
# REQUIRED in production — dev falls back to local JSON files
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
# Webhook secret for Sanity → REB cache revalidation
SANITY_WEBHOOK_SECRET=

# ── Image Upload (Vercel Blob) ────────────────────────────
# Optional — falls back to local /public/uploads in dev
BLOB_READ_WRITE_TOKEN=

# ── Billing (Stripe) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_SCAFFOLD_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Newsletter / Reports (Resend) ────────────────────────
RESEND_API_KEY=
RESEND_DOMAIN=updates.scaffoldweb.com

# ── Redis/Cache (Upstash) ─────────────────────────────────
# Required for rate limiting, session storage, tenant data
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Cron Jobs ─────────────────────────────────────────────
# Vercel sets this automatically for cron routes
CRON_SECRET=

# ── Internal API Security ─────────────────────────────────
# Secret for internal API routes (domain-map, etc.)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Notifications ─────────────────────────────────────────
# Optional — Slack notifications on AI changes + billing events
SLACK_WEBHOOK_URL=
# Clerk userId for Jacob. Used by the proof-signal pipeline to tag
# agent tool calls as "by Jacob" vs "by owner". When unset, every
# call is tagged as "by owner".
FOUNDER_CLERK_USER_ID=

# ── Cache Revalidation ────────────────────────────────────
# Per-tenant revalidation secrets are stored in tenant config (revalidationSecret field).
# Generate a unique secret per tenant: openssl rand -hex 32
# The tenant's client site validates X-Revalidation-Secret header against this value.

# ── Instagram Feed ────────────────────────────────────────
# Optional — Instagram section hidden if not set
INSTAGRAM_ACCESS_TOKEN=

# ── Multi-tenant ──────────────────────────────────────────
# JSON map of custom domains to tenant IDs (set in Vercel env)
# admin.* and www.* subdomains auto-resolve to base domain
CUSTOM_DOMAIN_MAP={"yourbusiness.com":"tenantid"}

# ── Domain Routing ────────────────────────────────────────
# Comma-separated lists — override defaults when adding domains
# MARKETING_DOMAINS=scaffoldweb.com,www.scaffoldweb.com,localhost,scaffold-web.vercel.app
# CORS_ORIGINS=https://yourbusiness.com,https://www.yourbusiness.com

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://scaffoldweb.com

# ── SMS (Twilio) ─────────────────────────────────────────
# Optional — falls back to console logging in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Google Search Console ─────────────────────────────────
# Service account key JSON — enables search query data in reports
GOOGLE_SEARCH_CONSOLE_KEY=

# ── Agent Behavior ────────────────────────────────────────
# Set to "false" to require admin review of AI content changes
AI_AUTO_PUBLISH=true

# ── SMS Suggestions (Feature Gate) ────────────────────────
# Disabled until security review complete. Set to "true" to enable.
SMS_SUGGESTIONS_ENABLED=false
CLERK_WEBHOOK_SECRET=
