# Strelva — Required Environment Variables
# Copy to .env.local and fill in values

# ── Auth + durable data (Supabase) ───────────────────────
# Auth is Supabase-only. Tenant access comes from memberships/super_admins in
# Postgres; there is no Clerk or env-email authorization fallback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the new Supabase name for the anon key
# in recent projects. Set one of the two — browser-client.ts reads both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL is the server-only copy of NEXT_PUBLIC_SUPABASE_URL used by the
# service-role client (src/lib/db/client.ts). Both must be set in production;
# omitting SUPABASE_URL silently disables all service-role Postgres operations
# (content writes, dual-write shadow, governed-work reconcile, etc.).
SUPABASE_URL=https://your-project.supabase.co

# ── AI Agent ──────────────────────────────────────────────
# Google Gemini (primary LLM for chat agent)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Anthropic Claude (optional fallback)
# ANTHROPIC_API_KEY=
# OpenAI (optional fallback)
# OPENAI_API_KEY=
# AI Fallback — provider name ("anthropic" or "openai") and model ID
# When set, agent retries with this model on Gemini transient failures.
# AI_FALLBACK_PROVIDER=anthropic
# AI_FALLBACK_MODEL=claude-sonnet-4-20250514

# ── Legacy Sanity image references (temporary) ───────────
# Content does not read or write Sanity. These two values only resolve legacy
# Sanity image asset references until the content URL rewrite is complete.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Data source flags ─────────────────────────────────────
# All three are fixed to Postgres in production. Local development may leave
# them unset only when deliberately using the dev-file adapters.
# Content sections (src/lib/storage/content-store.ts):
CONTENT_SOURCE=
# Tenant config — the spine (src/lib/tenants.ts):
TENANTS_SOURCE=
# Operational stores: drafts, audit, activity, analytics, reviews (src/lib/db/source-flags.ts):
DATA_SOURCE=

# ── Image Upload (Vercel Blob) ────────────────────────────
# Optional — falls back to local /public/uploads in dev
BLOB_READ_WRITE_TOKEN=

# ── Billing (Stripe) — optional ──────────────────────────
# Admin-side billing is off until STRIPE_SCAFFOLD_PRICE_ID is set. When
# configured it must be a live recurring monthly USD price. The exact amount
# is undecided while client sites are free; check:prod only validates shape.
STRIPE_SECRET_KEY=
STRIPE_SCAFFOLD_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Comma-separated tenant ids exempt from the subscription gate (treated as
# active). Inert while billing is off. IMPORTANT: set this in the SAME deploy
# that sets STRIPE_SCAFFOLD_PRICE_ID, listing all existing tenants (e.g.
# "gldf,rohlax"), so tenants without a subscriptionStatus don't get 402'd the
# moment billing flips on.
STRIPE_BILLING_GRANDFATHER_TENANTS=
# Connect and agency payment links. Everything here is off until Jacob turns it on.
# STRELVA_CONNECT=0
# Agency payment links on the agency's own Stripe account. Needs STRELVA_CONNECT=1 and an sk_test_ key unless STRELVA_AGENCY_PAY_LINKS_LIVE=1.
# STRELVA_AGENCY_PAY_LINKS=0
# Jacob's decision. Allows live-mode keys for agency payment links.
# STRELVA_AGENCY_PAY_LINKS_LIVE=0
# redis | postgres. Switch only after scripts/pay-links-backfill.ts --verify is clean.
# STRELVA_PAY_LINK_STORE=redis
# Unset until Jacob approves the Connect liability profile.
# STRELVA_CONNECT_PROFILE_VERSION=
# STRELVA_CONNECT_FEES_COLLECTOR=
# STRELVA_CONNECT_LOSSES_COLLECTOR=
# STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Newsletter / Reports (Resend) ────────────────────────
RESEND_API_KEY=
RESEND_DOMAIN=updates.strelva.com
# Global kill-switch for ALL outbound customer/prospect email. Sending is OFF
# unless this is exactly "true" — see emailSendingPaused() in
# src/lib/email-enabled.ts. Every email renders through the shared design system
# in src/lib/email/layout.ts (do not hand-roll email HTML). Env changes need a
# fresh `vercel deploy --prod`, not a redeploy.
EMAIL_SENDING_ENABLED=
OPERATOR_EMAILS_ENABLED=true
PROSPECT_EMAILS_ENABLED=true
CUSTOMER_EMAIL_ENABLED=false
# Comma-separated operator addresses that receive "new lead" notifications.
LEAD_NOTIFY_EMAILS=

# ── Redis/Cache (Upstash) ─────────────────────────────────
# Required for rate limiting, session storage, tenant data
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Cron Jobs ─────────────────────────────────────────────
# Vercel sets this automatically for cron routes
CRON_SECRET=

# ── Internal API Security ─────────────────────────────────
# Secret for internal API routes (domain-map, etc.)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
# Optional dedicated AES-256-GCM source for the browser-session public brief
# handoff. Falls back to INTERNAL_API_SECRET. Generate with openssl rand -hex 32.
# PUBLIC_CONTINUATION_SECRET=
# Exact marketing origin allowed to create the cross-subdomain handoff.
# PUBLIC_SITE_ORIGIN=https://strelva.com

# ── Notifications ─────────────────────────────────────────
# Optional — Slack notifications on AI changes + billing events
# Sentry needs both server/project and browser/client DSNs in production.
SLACK_WEBHOOK_URL=
SENTRY_DSN=
# Browser errors. Public value, inlined at build: set it before the production build. Unset = browser reporting off. Its ingest host is added to CSP connect-src automatically.
NEXT_PUBLIC_SENTRY_DSN=

# ── Vercel Integration ────────────────────────────────────
# Vercel API token for deploying custom client repos and managing projects
VERCEL_API_TOKEN=
# Vercel team ID for organizing deployments (optional, uses default team if unset)
VERCEL_TEAM_ID=
# Control plane API URL for client repos to fetch content + config.
# strelva.com is the MARKETING site and does NOT serve /api/v1/*; the control
# plane is app.strelva.com. Existing deployed repos may retain their legacy URL
# until a coordinated rollout; new provisioning uses this canonical value.
CONTROL_PLANE_API_URL=https://app.strelva.com

# ── Cache Revalidation ────────────────────────────────────
# Per-tenant revalidation secrets are stored in tenant config (revalidationSecret field).
# Generate a unique secret per tenant: openssl rand -hex 32
# The tenant's client site REVALIDATE_SECRET must match this value.
# Strelva signs revalidation requests with x-reb-timestamp and x-reb-signature.

# ── Optional Integrations (OAuth) ─────────────────────────
# Only needed when connecting these integrations for a tenant.
# Full descriptions live in .env.production.example.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# CALENDLY_WEBHOOK_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# OAUTH_STATE_SECRET=
# SECRETS_ENC_KEY — at-rest envelope encryption for provider secrets (AES-256-GCM).
# Keyless in dev (plaintext). In prod, required once the backfill has run.
# Generate: openssl rand -hex 32
# SECRETS_ENC_KEY=
# SUPER_ADMIN_EMAILS — operator console allow-list (comma-separated emails).
# SUPER_ADMIN_EMAILS=
# APPROVE_LINK_SECRET — approve-from-email HMAC; falls back to OAUTH_STATE_SECRET.
# APPROVE_LINK_SECRET=
# VEGARO_WEBHOOK_SECRET=
# SCAFFOLD_CUSTOM_REQUEST_SECRET=
# NEXT_PUBLIC_APP_URL=

# ── Multi-tenant ──────────────────────────────────────────
# JSON map of custom domains to tenant IDs (set in Vercel env)
# admin.* and www.* subdomains auto-resolve to base domain
CUSTOM_DOMAIN_MAP={"yourbusiness.com":"tenantid"}

# ── Domain Routing ────────────────────────────────────────
# Comma-separated lists — override defaults when adding domains
# Legacy marketing hosts that still reach this control-plane deployment.
# Production strelva.com is served by the separate strelva-marketing project.
# MARKETING_DOMAINS=scaffoldweb.com,www.scaffoldweb.com

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://strelva.com

# ── Google Search Console ─────────────────────────────────
# Service account key JSON — enables search query data in reports
GOOGLE_SEARCH_CONSOLE_KEY=

# ── Site Audit (Core Web Vitals) ─────────────────────────
# Optional. Google PageSpeed Insights API key — enables the audit's "Core Web
# Vitals" (web-vitals) + mobile categories with real load-speed data. Without
# it those categories grade honestly at weight 0 (see src/lib/audit/checks.ts).
GOOGLE_PAGESPEED_API_KEY=

# ── Visibility Tracker (SERP checks) ─────────────────────
# Serper.dev JSON API key — enables Google SERP checks in the weekly visibility
# cron (/api/cron/visibility). Without this key the cron skips SERP checks and
# records that honestly; AI-answer probes still run (they use GOOGLE_GENERATIVE_AI_API_KEY).
# Get a key at: https://serper.dev — Starter plan ~$0.001/query.
# Default cost: 3 queries/tenant/week ≈ $0.012/tenant/month (well inside <20%-of-price rule).
SERP_API_KEY=

# ── Agent Behavior ────────────────────────────────────────
# Keep false for pilots; enable only after tenant-specific review and approval.
AI_AUTO_PUBLISH=false

# ── Self-Serve Auto-Provisioning (Feature Gate) ──────────
# Disabled. Every Strelva site is hand-built; the only lead path is
# /access-request. Flip to "true" only when self-serve template flows are
# explicitly re-enabled.
SELF_SERVE_ENABLED=false

# Horizontal local work remains opt-in. Enable only after applying its migrations
# and completing the corresponding local/provider release acceptance.
STRELVA_WORKSPACE_RELEASE=0
# The Systems model: Systems on Home, System pages, Possibilities, Make real
# and Versions (1.0.0 launch features). Needs STRELVA_WORKSPACE_RELEASE=1 too.
# Off, the workspace renders as it did before Systems.
STRELVA_SYSTEMS_RELEASE=0
# Built-in App Releases on screen ("Bookings Release 1") and each App's Needs.
# Exposure only; Make it live connection checks do not depend on it. Needs
# STRELVA_WORKSPACE_RELEASE=1 too.
STRELVA_APP_RELEASES=0
# Care plan reports (agency monthly report per client). Needs STRELVA_WORKSPACE_RELEASE=1.
# 0/unset = off; workspace = per-business flag rows; 1 = on except rows set off.
STRELVA_CARE_REPORTS_RELEASE=0
# Email a shared report to the owner under the agency's name. Also needs EMAIL_SENDING_ENABLED=true. Off by decision.
STRELVA_CARE_REPORT_EMAIL=0
# Unguessable, revocable read-only links to a shared report, for owners without an account.
STRELVA_CARE_REPORT_SHARE_LINKS=0
# The agency front door (#258): "I run a business / I run an agency" on
# /sign-up and the agency setup checklist at /workspace/agency/start. Needs
# STRELVA_WORKSPACE_RELEASE=1 too. Agency creation itself is not gated here.
STRELVA_AGENCY_SIGNUP_RELEASE=0
# The owner door (Getting started): direct business sign-up on /sign-up, the
# check-to-business handoff ("Start with this fix" creates the business from
# the check's name and website) and the Getting started first-run view. Needs
# STRELVA_WORKSPACE_RELEASE=1 too. Off: /sign-up stays closed to direct
# business sign-up even when the workspace is open.
STRELVA_BUSINESS_SIGNUP_RELEASE=0
# Request planning also requires a configured model provider. Keep off until
# provider use is authorized; preparing a proposal can incur model charges.
STRELVA_PLANNING_ENABLED=0
STRELVA_BACKGROUND_WORK_RELEASE=0
# Per-client usage controls: an agency or Strelva operator can pause one
# client's Strelva work, set a monthly usage limit and hold automatic review
# replies. Needs STRELVA_WORKSPACE_RELEASE=1 and the ai_controls migration.
STRELVA_AI_CONTROLS_RELEASE=0
# Events Apps receive (app_events). unset/0 off, workspace = per business, 1 = on except rows set off.
# Capture is a separate database switch (pnpm app-events capture on), off by default.
STRELVA_APP_EVENTS_RELEASE=0
# Signed webhooks to outside makers. Needs STRELVA_APP_EVENTS_RELEASE too.
STRELVA_APP_EVENT_WEBHOOKS_RELEASE=0
# Listings in sync (built-in App). Workspace release flag `listings_sync`:
# unset/0 = off; workspace = per-business rows; 1 = on except rows set off.
STRELVA_LISTINGS_SYNC_RELEASE=0
# Release 2: put confirmed hours/phone on Google when the owner makes it live.
# Also needs Google approval (STRELVA_CONNECTION_APPROVAL_GOOGLE_BUSINESS_PROFILE).
STRELVA_LISTINGS_SYNC_GOOGLE_FIX=0
# Read-only Yelp comparison through a tenant's Yelp key (paid Yelp API terms apply).
STRELVA_LISTINGS_SYNC_YELP=0
# Needs you email for listings items. Also needs EMAIL_SENDING_ENABLED.
STRELVA_LISTINGS_SYNC_OWNER_EMAIL=0
# Dental intake (new-patient form on a connected site). unset/0 off, workspace = per business, 1 = on except rows set off.
# Needs STRELVA_WORKSPACE_RELEASE=1 and connected sites. Read docs/capabilities/apps/dental-intake.md first.
STRELVA_VERTICAL_INTAKE_RELEASE=0
# Insurance member ID on the form. Off until counsel and a business associate agreement are in place.
# Needs SECRETS_ENC_KEY, and the install must also turn it on. Stored as ciphertext, purged after 30 days.
STRELVA_INTAKE_SENSITIVE_FIELDS=0
# Needs you emails to the owner about Dental intake (Make it live, visits to confirm). Needs EMAIL_SENDING_ENABLED too.
# Patients are never emailed by this App; customer email has its own switch.
STRELVA_INTAKE_OWNER_EMAIL=0
# A list-price billing ceiling for configured models, so a capped business's
# work (tool runs included) is admitted per provider request until its cap.
# Estimate-based; read ADR 0015 before turning it on.
STRELVA_AI_LIST_PRICE_CEILING=0
# Internal research only: activation still requires active super-admin status
# and membership in the exact workspace. This flag does not schedule collection.
STRELVA_PRODUCT_LEARNING_RELEASE=0

# Wave 6: accept a pending operator-issued owner invitation after verified magic-link entry.
# Also requires owner entry on for this business. Off by default; sends nothing.
STRELVA_OWNER_INVITATION_CLAIM=0
# Operator invitation panel and endpoint. Invites remain deferred; no automatic send.
STRELVA_OWNER_INVITATIONS_RELEASE=0
# Account-free routine owner decisions; access, money and exit require sign-in.
# Supports 0/workspace/1 like the other workspace release flags.
STRELVA_OWNER_DECISION_LINKS_RELEASE=0
# Ask only logs usage/cost at launch. Optional daily operator warning threshold, USD.
# Unset disables the warning. This never charges or changes plan allowances.
STRELVA_ASK_COST_ALERT_USD=
# ── App / hosted-site roots (#322; activation requires #243) ──
# Bare DNS apexes, no protocol/port/path. Both independently default to
# strelva.com when omitted. These NEXT_PUBLIC values are baked into the build:
# changing them requires an authorized new build/deployment, never a redeploy.
# NEXT_PUBLIC_APP_ROOT_DOMAIN=strelva.com
# NEXT_PUBLIC_SITES_ROOT_DOMAIN=strelva.com
# Set the sites value only after Jacob chooses a separate registrable apex and
# authorizes wildcard DNS/certificates. App/admin and sender domains stay put.

# ── One path per job (all off by default; none turns on client email) ──
# Emailed Approve/Not yet links and signed-in tenant-event decisions go through
# Needs you for a converted business. Needs STRELVA_NEEDS_YOU_RELEASE=1.
STRELVA_ONE_APPROVAL_PATH=0
# The review auto-post records a policy decision first. Needs migration
# 20261027110000 and Needs you released.
STRELVA_AUTO_POST_DECISION_RECORD=0
# /api/admin/invites and /api/admin/tenants/assign use workspace invitations for
# converted businesses (operators invite the owner only).
STRELVA_ONE_INVITATION_PATH=0
# Workspace invitation email. Also needs EMAIL_SENDING_ENABLED and
# CUSTOMER_EMAIL_ENABLED, which stay off by decision: without them the screen
# says nothing was emailed and shows the link.
STRELVA_INVITATION_EMAIL_RELEASE=0
# Agency Queue lists reviews drafts, pending Requests and site work; /admin/queue
# drops client work an agency holds. Needs migration 20261027111000.
STRELVA_ONE_QUEUE=0
# With STRELVA_BOOKING_STORE_READ unset, every booking surface reads Postgres
# (once STRELVA_BOOKING_STORE_WRITE=1 and the 7-day parity streak hold).
# STRELVA_BOOKING_STORE_READ=legacy pins legacy. Unset by default.
# STRELVA_BOOKING_READ_POSTGRES_DEFAULT=1
