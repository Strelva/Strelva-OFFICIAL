# Strelva — Required Environment Variables
# Copy to .env.local and fill in values

# ── Auth + durable data (Supabase) ───────────────────────
# Auth is Supabase-only. Tenant access comes from memberships/super_admins in
# Postgres; there is no Clerk or env-email authorization fallback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the new Supabase name for the anon key
# in recent projects. Set one of the two — browser-client.ts reads both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL is the server-only copy of NEXT_PUBLIC_SUPABASE_URL used by the
# service-role client (src/lib/db/client.ts). Both must be set in production;
# omitting SUPABASE_URL silently disables all service-role Postgres operations
# (content writes, dual-write shadow, governed-work reconcile, etc.).
SUPABASE_URL=https://your-project.supabase.co

# ── AI Agent ──────────────────────────────────────────────
# Google Gemini (primary LLM for chat agent)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Anthropic Claude (optional fallback)
# ANTHROPIC_API_KEY=
# OpenAI (optional fallback)
# OPENAI_API_KEY=
# AI Fallback — provider name ("anthropic" or "openai") and model ID
# When set, agent retries with this model on Gemini transient failures.
# AI_FALLBACK_PROVIDER=anthropic
# AI_FALLBACK_MODEL=claude-sonnet-4-20250514

# ── Legacy Sanity image references (temporary) ───────────
# Content does not read or write Sanity. These two values only resolve legacy
# Sanity image asset references until the content URL rewrite is complete.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Data source flags ─────────────────────────────────────
# All three are fixed to Postgres in production. Local development may leave
# them unset only when deliberately using the dev-file adapters.
# Content sections (src/lib/storage/content-store.ts):
CONTENT_SOURCE=
# Tenant config — the spine (src/lib/tenants.ts):
TENANTS_SOURCE=
# Operational stores: drafts, audit, activity, analytics, reviews (src/lib/db/source-flags.ts):
DATA_SOURCE=

# ── Image Upload (Vercel Blob) ────────────────────────────
# Optional — falls back to local /public/uploads in dev
BLOB_READ_WRITE_TOKEN=

# ── Billing (Stripe) — optional ──────────────────────────
# Admin-side billing is off until STRIPE_SCAFFOLD_PRICE_ID is set. When
# configured it must be a live recurring monthly USD price. The exact amount
# is undecided while client sites are free; check:prod only validates shape.
STRIPE_SECRET_KEY=
STRIPE_SCAFFOLD_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Comma-separated tenant ids exempt from the subscription gate (treated as
# active). Inert while billing is off. IMPORTANT: set this in the SAME deploy
# that sets STRIPE_SCAFFOLD_PRICE_ID, listing all existing tenants (e.g.
# "gldf,rohlax"), so tenants without a subscriptionStatus don't get 402'd the
# moment billing flips on.
STRIPE_BILLING_GRANDFATHER_TENANTS=

# ── Newsletter / Reports (Resend) ────────────────────────
RESEND_API_KEY=
RESEND_DOMAIN=updates.strelva.com
# Global kill-switch for ALL outbound customer/prospect email. Sending is OFF
# unless this is exactly "true" — see emailSendingPaused() in
# src/lib/email-enabled.ts. Every email renders through the shared design system
# in src/lib/email/layout.ts (do not hand-roll email HTML). Env changes need a
# fresh `vercel deploy --prod`, not a redeploy.
EMAIL_SENDING_ENABLED=
OPERATOR_EMAILS_ENABLED=true
PROSPECT_EMAILS_ENABLED=true
CUSTOMER_EMAIL_ENABLED=false
# Comma-separated operator addresses that receive "new lead" notifications.
LEAD_NOTIFY_EMAILS=

# ── Redis/Cache (Upstash) ─────────────────────────────────
# Required for rate limiting, session storage, tenant data
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Cron Jobs ─────────────────────────────────────────────
# Vercel sets this automatically for cron routes
CRON_SECRET=

# ── Internal API Security ─────────────────────────────────
# Secret for internal API routes (domain-map, etc.)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Notifications ─────────────────────────────────────────
# Optional — Slack notifications on AI changes + billing events
# Sentry needs both server/project and browser/client DSNs in production.
SLACK_WEBHOOK_URL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Vercel Integration ────────────────────────────────────
# Vercel API token for deploying custom client repos and managing projects
VERCEL_API_TOKEN=
# Vercel team ID for organizing deployments (optional, uses default team if unset)
VERCEL_TEAM_ID=
# Control plane API URL for client repos to fetch content + config.
# strelva.com is the MARKETING site and does NOT serve /api/v1/*; the control
# plane is app.strelva.com. Existing deployed repos may retain their legacy URL
# until a coordinated rollout; new provisioning uses this canonical value.
CONTROL_PLANE_API_URL=https://app.strelva.com

# ── Cache Revalidation ────────────────────────────────────
# Per-tenant revalidation secrets are stored in tenant config (revalidationSecret field).
# Generate a unique secret per tenant: openssl rand -hex 32
# The tenant's client site REVALIDATE_SECRET must match this value.
# Strelva signs revalidation requests with x-reb-timestamp and x-reb-signature.

# ── Optional Integrations (OAuth) ─────────────────────────
# Only needed when connecting these integrations for a tenant.
# Full descriptions live in .env.production.example.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# CALENDLY_WEBHOOK_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# OAUTH_STATE_SECRET=
# SECRETS_ENC_KEY — at-rest envelope encryption for provider secrets (AES-256-GCM).
# Keyless in dev (plaintext). In prod, required once the backfill has run.
# Generate: openssl rand -hex 32
# SECRETS_ENC_KEY=
# SUPER_ADMIN_EMAILS — operator console allow-list (comma-separated emails).
# SUPER_ADMIN_EMAILS=
# APPROVE_LINK_SECRET — approve-from-email HMAC; falls back to OAUTH_STATE_SECRET.
# APPROVE_LINK_SECRET=
# VEGARO_WEBHOOK_SECRET=
# SCAFFOLD_CUSTOM_REQUEST_SECRET=
# NEXT_PUBLIC_APP_URL=

# ── Multi-tenant ──────────────────────────────────────────
# JSON map of custom domains to tenant IDs (set in Vercel env)
# admin.* and www.* subdomains auto-resolve to base domain
CUSTOM_DOMAIN_MAP={"yourbusiness.com":"tenantid"}

# ── Domain Routing ────────────────────────────────────────
# Comma-separated lists — override defaults when adding domains
# Legacy marketing hosts that still reach this control-plane deployment.
# Production strelva.com is served by the separate strelva-marketing project.
# MARKETING_DOMAINS=scaffoldweb.com,www.scaffoldweb.com

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://strelva.com

# ── Google Search Console ─────────────────────────────────
# Service account key JSON — enables search query data in reports
GOOGLE_SEARCH_CONSOLE_KEY=

# ── Site Audit (Core Web Vitals) ─────────────────────────
# Optional. Google PageSpeed Insights API key — enables the audit's "Core Web
# Vitals" (web-vitals) + mobile categories with real load-speed data. Without
# it those categories grade honestly at weight 0 (see src/lib/audit/checks.ts).
GOOGLE_PAGESPEED_API_KEY=

# ── Visibility Tracker (SERP checks) ─────────────────────
# Serper.dev JSON API key — enables Google SERP checks in the weekly visibility
# cron (/api/cron/visibility). Without this key the cron skips SERP checks and
# records that honestly; AI-answer probes still run (they use GOOGLE_GENERATIVE_AI_API_KEY).
# Get a key at: https://serper.dev — Starter plan ~$0.001/query.
# Default cost: 3 queries/tenant/week ≈ $0.012/tenant/month (well inside <20%-of-price rule).
SERP_API_KEY=

# ── Agent Behavior ────────────────────────────────────────
# Keep false for pilots; enable only after tenant-specific review and approval.
AI_AUTO_PUBLISH=false

# ── Self-Serve Auto-Provisioning (Feature Gate) ──────────
# Disabled. Every Strelva site is hand-built; the only lead path is
# /access-request. Flip to "true" only when self-serve template flows are
# explicitly re-enabled.
SELF_SERVE_ENABLED=false
