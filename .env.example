# REB — Required Environment Variables
# Copy to .env.local and fill in values

# ── Auth (Clerk) ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Super admin emails (comma-separated) — these users get admin access
SUPER_ADMIN_EMAILS=laney@buffaloprojects.com,laneyfraass@gmail.com

# ── AI Agent ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# ── Content Storage (Sanity CMS) ──────────────────────────
# Optional — falls back to local dev-content.json if not set
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ── Image Upload (Vercel Blob) ────────────────────────────
# Optional — image upload disabled if not set
BLOB_READ_WRITE_TOKEN=

# ── Notifications ─────────────────────────────────────────
# Optional — Slack notifications on AI content updates
SLACK_WEBHOOK_URL=

# ── Instagram Feed ────────────────────────────────────────
# Optional — Instagram section hidden if not set
INSTAGRAM_ACCESS_TOKEN=

# ── Newsletter (Resend) ───────────────────────────────────
# Optional — newsletters logged to console if not set
RESEND_API_KEY=
RESEND_DOMAIN=updates.rohlaxwellness.com

# ── Site URL ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rohlaxwellness.com
