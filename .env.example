# REB — Required Environment Variables
# Copy to .env.local and fill in values

# ── Auth (Clerk) ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Super admin emails (comma-separated) — these users get admin access
SUPER_ADMIN_EMAILS=rhinehart514@gmail.com

# ── AI Agent ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# ── Content Storage (Sanity CMS) ──────────────────────────
# REQUIRED in production — dev falls back to local JSON files
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ── Image Upload (Vercel Blob) ────────────────────────────
# Optional — falls back to local /public/uploads in dev
BLOB_READ_WRITE_TOKEN=

# ── Billing (Stripe) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_REB_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Newsletter / Reports (Resend) ────────────────────────
RESEND_API_KEY=
RESEND_DOMAIN=updates.reb.studio

# ── Cron Jobs ─────────────────────────────────────────────
# Vercel sets this automatically for cron routes
CRON_SECRET=

# ── Notifications ─────────────────────────────────────────
# Optional — Slack notifications on AI changes + billing events
SLACK_WEBHOOK_URL=

# ── Instagram Feed ────────────────────────────────────────
# Optional — Instagram section hidden if not set
INSTAGRAM_ACCESS_TOKEN=

# ── Multi-tenant ──────────────────────────────────────────
# JSON map of custom domains to tenant IDs (set in Vercel env)
CUSTOM_DOMAIN_MAP={}

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://reb.studio

# ── Agent Behavior ────────────────────────────────────────
# Set to "false" to require admin review of AI content changes
AI_AUTO_PUBLISH=true
