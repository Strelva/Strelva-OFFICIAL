{
  "name": "scaffold-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:launch": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit && pnpm build && REB_DEV_UNGATED_ACCESS=0 pnpm smoke",
    "check:release": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit && pnpm build && pnpm check:prod && REB_DEV_UNGATED_ACCESS=0 pnpm smoke",
    "smoke": "playwright test",
    "provision-tenant": "npx tsx scripts/provision-tenant.ts",
    "seed-tenant": "npx tsx scripts/seed-tenant.ts",
    "check:prod": "tsx scripts/production-checklist.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.71",
    "@clerk/nextjs": "7.3.3",
    "@sanity/client": "7.22.0",
    "@sanity/image-url": "2.1.1",
    "@sentry/nextjs": "10.52.0",
    "@studio-freight/lenis": "^1.0.42",
    "@upstash/redis": "1.38.0",
    "@vercel/blob": "^2.3.3",
    "ai": "6.0.177",
    "date-fns": "4.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.14.0",
    "next": "16.2.6",
    "next-sanity": "12.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "resend": "6.12.3",
    "sanity": "5.24.0",
    "stripe": "22.1.1",
    "svix": "1.93.0",
    "twilio": "6.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.13",
      "brace-expansion@>=4 <5.0.5": "5.0.5",
      "dompurify": "3.4.0",
      "fast-uri": "3.1.2",
      "flatted": "3.4.2",
      "js-yaml@<4": "3.14.2",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.4",
      "postcss": "8.5.10",
      "uuid@>=11 <12": "11.1.1",
      "uuid@>=13 <13.0.1": "13.0.1",
      "@babel/plugin-transform-modules-systemjs": "7.29.4"
    }
  }
}
