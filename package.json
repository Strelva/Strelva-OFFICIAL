{
  "name": "strelva",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "dev:clean": "pkill -f next-server 2>/dev/null; pkill -f 'next dev' 2>/dev/null; echo 'cleared stray next dev servers'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:launch": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit && pnpm build && PLAYWRIGHT_BUILT_APP=1 REB_DEV_UNGATED_ACCESS=0 pnpm smoke",
    "check:release": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit && pnpm build && pnpm check:prod && PLAYWRIGHT_BUILT_APP=1 REB_DEV_UNGATED_ACCESS=0 pnpm smoke",
    "smoke": "playwright test",
    "smoke:admin": "REB_DEV_UNGATED_ACCESS=1 playwright test tests/admin-operator.spec.ts",
    "smoke:dashboard": "REB_DEV_UNGATED_ACCESS=1 REB_DEV_TENANT=gldf playwright test tests/dashboard-owner.spec.ts",
    "smoke:surfaces": "REB_DEV_UNGATED_ACCESS=1 REB_DEV_TENANT=gldf playwright test tests/operator-surfaces.spec.ts tests/owner-surfaces.spec.ts",
    "check:ci": "bash scripts/check-ci.sh",
    "bench:agent": "npx tsx scripts/run-benchmark.ts",
    "provision-tenant": "npx tsx scripts/provision-tenant.ts",
    "deprovision-tenant": "npx tsx --env-file=.env.local scripts/deprovision-tenant.ts",
    "seed-tenant": "npx tsx scripts/seed-tenant.ts",
    "check:custom-repos": "tsx scripts/custom-repo-workspace-check.ts",
    "check:ontology": "tsx scripts/check-ontology.ts",
    "audit:full": "npx tsx --env-file-if-exists=.env.local scripts/full-audit.ts",
    "check:prod": "tsx scripts/production-checklist.ts",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-version-sync.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.78",
    "@ai-sdk/google": "3.0.43",
    "@ai-sdk/openai": "3.0.64",
    "@sanity/image-url": "2.1.0",
    "@sentry/nextjs": "10.51.0",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@upstash/redis": "1.37.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "^2.3.3",
    "ai": "6.0.116",
    "cheerio": "^1.2.0",
    "gsap": "^3.14.2",
    "isomorphic-dompurify": "2.36.0",
    "lucide-react": "0.577.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "resend": "6.9.4",
    "stripe": "21.0.1",
    "svix": "1.92.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  }
}
