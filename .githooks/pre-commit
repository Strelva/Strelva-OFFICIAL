#!/usr/bin/env sh
# Same version/policy/config as Security CI; staged changes only. The explicit
# native path remains local diagnostic evidence, not upstream-image proof.
if command -v gitleaks >/dev/null 2>&1; then
  node scripts/check-secrets.mjs --native --staged || exit 1
elif command -v docker >/dev/null 2>&1; then
  node scripts/check-secrets.mjs --staged || exit 1
else
  echo "No qualified secret scanner is available. Commit refused; use the pinned scanner or review an explicit override."
  exit 1
fi
