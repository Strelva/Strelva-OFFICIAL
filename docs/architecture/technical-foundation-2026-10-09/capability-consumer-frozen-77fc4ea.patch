diff --git a/src/server/capability-consumer-availability.ts b/src/server/capability-consumer-availability.ts
new file mode 100644
--- /dev/null
+++ b/src/server/capability-consumer-availability.ts
@@ -0,0 +1,28 @@
+import "server-only";
+import { capabilityAvailability } from "@/capability-availability";
+import { listCapabilities, workspaceDiscoveryProducts, workspaceExecutables } from "@/capability-registry";
+import { EXECUTABLE_CAPABILITY_DEFINITIONS } from "@/server/capabilities";
+import type { CapabilityAvailabilitySnapshot } from "@/platform/capabilities/inventory-contracts";
+import type { ReleaseViewer } from "@/platform/release-flags/resolve";
+
+/** App-edge projection shared by authenticated consumers, not public discovery.
+ * Existing owners select the keys; internal-only operations and tenant catalog
+ * slices are not newly exposed. No installation or tool/operation alias inferred.
+ * Missing owner prerequisite readers remain unknown. No runtime admission change. */
+export async function readWorkspaceCapabilityAvailability(
+  workspaceId: string, viewer: ReleaseViewer,
+): Promise<CapabilityAvailabilitySnapshot | null> {
+  try {
+    const keys = [
+      ...workspaceDiscoveryProducts().map(item => `product:${item.id}`),
+      ...workspaceExecutables().map(item => `workspace_executable:${item.id}`),
+      ...listCapabilities({ kind: "offering" }).map(item => item.key),
+      ...EXECUTABLE_CAPABILITY_DEFINITIONS.filter(item => item.support !== "internal_only").map(item => `operation:${item.id}@${item.version}`),
+    ];
+    return { workspaceId, entries: await capabilityAvailability(keys, { workspaceId, viewer }) };
+  } catch {
+    // An optional proof read cannot overturn a completed required native read.
+    // Absence is unconfirmed evidence, never available execution or a write result.
+    return null;
+  }
+}
